# Adguard-home
IP=xx.xx.xx.xx # IP of the server

# Beszel
APP_URL=http://xx.xx.xx.xx:8090

# Homelable
SECRET_KEY=secret_key # openssl rand -base64 32
AUTH_PASSWORD_HASH='hash' # python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"  -- maybe you need to install bcrypt first: sudo apt install python3-bcrypt -y
CORS_ORIGINS=["http://IP:8088"]

# Linux Update Dashboard
LUDASH_ENCRYPTION_KEY=your_encryption_key_here # openssl rand -base64 32
LUDASH_BASE_URL=https://LUM.url

# Watchtower
GOTIFY_URL=gotify.url
GOTIFY_TOKEN=secrettoken