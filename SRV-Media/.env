# Immich
DB_USERNAME=db_user
DB_PASSWORD=db_password
DB_DATABASE_NAME=db_name
REDIS_PASSWORD=redis_password

# NFS setup
IP=xx.xx.xx.xx
CACHE=:/path/to/cache
MOVIES=:/path/to/movies
MOVIES_CZSK=:/path/to/movies-czsk # remove if you don't have a czech/slovak movies share
PHOTOS=:/path/to/photos

# Tdarr
TDARR_API_KEY=api_key # openssl rand -hex 16, after initial setup copy key from Tdarr

# Watchtower
GOTIFY_URL=gotify.url
GOTIFY_TOKEN=secrettoken